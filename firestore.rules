rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // RPM: setiap akun hanya bisa membaca dan menulis datanya sendiri
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Jika proyek Firebase ini juga dipakai aplikasi lain (misalnya Wiraga), gabungkan aturan di atas
    // dengan aturan yang sudah ada. Jangan menimpa aturan lama.
  }
}
